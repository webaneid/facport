# .env.production.example
# Copy jadi .env.production DI SERVER (bukan di git), isi nilai asli.
# File ini (.env.production.example) boleh dicommit sebagai referensi,
# TAPI .env.production yang asli JANGAN PERNAH di-commit.

GITHUB_REPO=webaneid/facport
IMAGE_TAG=latest

DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

NEXT_PUBLIC_API_URL=https://api.namadomain.com
NEXT_PUBLIC_APP_URL=https://app.namadomain.com
WEB_ORIGINS_PROD=https://namadomain.com,https://admin.namadomain.com,https://app.namadomain.com
APP_ORIGIN_PROD=https://app.namadomain.com
COOKIE_DOMAIN=.namadomain.com

# Observability — lihat docs/architecture/architecture-observability.md
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# Auth (Better Auth) — lihat docs/architecture/architecture-auth.md
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.namadomain.com

# Notifikasi — lihat docs/architecture/architecture-notifications.md
RESEND_API_KEY=
EMAIL_FROM=noreply@namadomain.com

# Payment — provider final belum diputuskan (Ipaymu/Xendit), lihat
# docs/architecture/architecture-payment.md. Isi salah satu blok berikut
# begitu provider dipilih.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=true

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Accurate Online — Authorization Code Grant, terverifikasi § architecture-accurate-integration.md §1
# Redirect URI mengarah LANGSUNG ke domain api (bukan app/web) — code tukar
# token butuh client_secret, WAJIB di server.
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
ACCURATE_REDIRECT_URI=https://api.namadomain.com/accurate/oauth/callback
ACCURATE_TOKEN_ENCRYPTION_KEY=
