# apps/api/.env.example
# Copy jadi .env untuk development lokal. JANGAN commit .env asli.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dbname_dev

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Base URL yang bisa diakses BROWSER untuk bucket public (logo/favicon
# company) — § Fase 12, ADR-0017. Dev: sama dengan MINIO_ENDPOINT+PORT di
# atas karena MinIO dev diekspos langsung ke host. Prod: domain terpisah
# (mis. https://media.facport.com) yang di-reverse-proxy Caddy ke MinIO.
MINIO_PUBLIC_URL=http://localhost:9000

PORT=3001

# Observability (kosongkan = disabled, aman untuk dev lokal) — lihat
# docs/architecture/architecture-observability.md
SENTRY_DSN_API=
LOG_LEVEL=debug

# Auth (Better Auth) — lihat docs/architecture/architecture-auth.md
BETTER_AUTH_SECRET=ganti-dengan-random-string-panjang-buat-dev
BETTER_AUTH_URL=http://localhost:3001

# Login/Register Google (OAuth) — OPSIONAL, kosongkan kalau belum setup
# Google Cloud Console (fitur otomatis nonaktif, § ADR-0030). Redirect URI
# yang WAJIB didaftarkan di Google Cloud Console: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Origin frontend production — WAJIB ketiga surface (landing/admin/app),
# dipisah koma. Kosongkan di dev lokal.
WEB_ORIGINS_PROD=
# Origin surface "app" saja — target redirect setelah OAuth callback Accurate
APP_ORIGIN_PROD=
# Origin surface "admin" saja — link login di email welcome staff/admin baru
ADMIN_ORIGIN_PROD=

# Cross-subdomain session cookie (§ architecture-domain-routing.md) —
# ".localhost" dev, ".facport.com" prod (contoh, ganti sesuai domain asli)
COOKIE_DOMAIN=.localhost

# Notifikasi — lihat docs/architecture/architecture-notifications.md
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost.test

# § Fase 16, ADR-0022 — Payment MANUAL (transfer bank + QRIS), TIDAK ADA
# payment gateway apa pun — TIDAK ADA env var provider di sini. Konfigurasi
# rekening bank/QRIS disimpan di DB (settings), diatur lewat halaman admin.
# Lihat docs/architecture/architecture-payment.md

# Accurate Online — Authorization Code Grant, terverifikasi § architecture-accurate-integration.md §1
# Redirect URI mengarah LANGSUNG ke apps/api (bukan apps/web) — code tukar
# token butuh client_secret, WAJIB di server.
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
# § Fase 143/144 — callback WAJIB berada di sesi login yang sama dengan pemulai flow (cookie sesi ikut terkirim). Production:
# api.<domain> (cookie lintas-subdomain). DEV: browser memanggil API lewat proxy web (cookie sesi milik app.localhost),
# jadi pakai redirect URI LEWAT PROXY dan daftarkan URI itu juga di portal developer Accurate (URL OAuth Callback boleh
# lebih dari satu, pisahkan dengan Enter):
#   ACCURATE_REDIRECT_URI=http://app.localhost:6209/api-proxy/accurate/oauth/callback
ACCURATE_REDIRECT_URI=http://localhost:3001/accurate/oauth/callback
ACCURATE_TOKEN_ENCRYPTION_KEY=ganti-dengan-random-string-panjang-buat-dev

# Fase 167 — jumlah koneksi Accurate yang diproses paralel oleh worker import (default 2, 1-8). Worker harus tetap 1 container.
# IMPORT_WORKER_CONCURRENCY=2

# Fase 199 — timeout panggilan ke Accurate (sebelumnya default runtime Bun, bergeser antar versi). save.do: adaptif = baris detail × ms/baris, dijepit min–max.
# Biaya Accurate terukur ±0,25–0,28 dtk/baris (linear); 600 ms/baris = faktor ±2×. Semua opsional.
# ACCURATE_SAVE_TIMEOUT_MIN_MS=360000
# ACCURATE_SAVE_TIMEOUT_MAX_MS=3600000
# ACCURATE_SAVE_MS_PER_LINE=600
# ACCURATE_REQUEST_TIMEOUT_MS=360000

# Fase 199 — jalur terpisah batch besar: batch ≥ IMPORT_LARGE_BATCH_ROWS baris diproses di slot sendiri (IMPORT_LARGE_WORKER_CONCURRENCY) agar tidak
# menghabiskan slot batch kecil pelanggan lain. Semua opsional.
# IMPORT_LARGE_BATCH_ROWS=1500
# IMPORT_LARGE_WORKER_CONCURRENCY=2

# Fase 199 (C2) — setelah save.do timeout, Facport memeriksa Accurate lewat NOMOR transaksi (polling) untuk tahu apakah sudah tersimpan. Opsional.
# ACCURATE_VERIFY_MAX_WAIT_MS=300000
# ACCURATE_VERIFY_INTERVAL_MS=30000

# Fase 199 (C4b) — grup (dokumen) dalam SATU job impor diproses paralel sampai N (1 = berurutan seperti dulu, 1–6). Batas Accurate 8 req/dtk & 8 paralel per koneksi tetap
# dijaga pembatas per koneksi. Naikkan bertahap (1 → 2 → 3) sambil memantau log "Import batch selesai" (parallelism, durationMs) dan galat.
# IMPORT_GROUP_PARALLELISM=1

# Fase 205 (ADR-0051) — dokumen BESAR (1 nomor, ribuan baris) dikirim BERTAHAP ke dokumen yang SAMA di Accurate (nomor & isi tidak berubah; hanya cara kirim).
# Lebih lambat dari sekali kirim (Accurate memproses dokumen ∝ N²), tetapi tiap langkah punya batas sendiri, kemajuan tersimpan di Accurate, dan bisa dilanjutkan.
# Kosong = MATI (perilaku lama). Modul yang didukung: sales_receipt, purchase_payment. Pelanggan diminta menyetujui lewat popup sebelum kirim.
# IMPORT_STAGED_MODULES=sales_receipt,purchase_payment
# IMPORT_STAGED_THRESHOLD_ROWS=200
# IMPORT_STAGED_CHUNK_ROWS=500
# IMPORT_STAGED_MAX_ATTEMPTS=4
# IMPORT_STAGED_BACKOFF_BASE_MS=30000
# IMPORT_STAGED_POLL_INTERVAL_MS=15000
# IMPORT_STAGED_SECONDS_COEFF=7e-4
# IMPORT_STAGED_MAX_ESTIMATE_SECONDS=86400
# IMPORT_STAGED_MAX_RESUMES=5
