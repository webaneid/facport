# apps/api/.env.example
# Copy jadi .env untuk development lokal. JANGAN commit .env asli.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dbname_dev

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Base URL yang bisa diakses BROWSER untuk bucket public (logo/favicon
# company) — § Fase 12, ADR-0017. Dev: sama dengan MINIO_ENDPOINT+PORT di
# atas karena MinIO dev diekspos langsung ke host. Prod: domain terpisah
# (mis. https://media.facport.com) yang di-reverse-proxy Caddy ke MinIO.
MINIO_PUBLIC_URL=http://localhost:9000

PORT=3001

# Observability (kosongkan = disabled, aman untuk dev lokal) — lihat
# docs/architecture/architecture-observability.md
SENTRY_DSN_API=
LOG_LEVEL=debug

# Auth (Better Auth) — lihat docs/architecture/architecture-auth.md
BETTER_AUTH_SECRET=ganti-dengan-random-string-panjang-buat-dev
BETTER_AUTH_URL=http://localhost:3001

# Origin frontend production — WAJIB ketiga surface (landing/admin/app),
# dipisah koma. Kosongkan di dev lokal.
WEB_ORIGINS_PROD=
# Origin surface "app" saja — target redirect setelah OAuth callback Accurate
APP_ORIGIN_PROD=

# Cross-subdomain session cookie (§ architecture-domain-routing.md) —
# ".localhost" dev, ".facport.com" prod (contoh, ganti sesuai domain asli)
COOKIE_DOMAIN=.localhost

# Notifikasi — lihat docs/architecture/architecture-notifications.md
RESEND_API_KEY=
EMAIL_FROM=noreply@localhost.test

# Payment — provider final belum diputuskan (Ipaymu/Xendit), lihat
# docs/architecture/architecture-payment.md
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Accurate Online — Authorization Code Grant, terverifikasi § architecture-accurate-integration.md §1
# Redirect URI mengarah LANGSUNG ke apps/api (bukan apps/web) — code tukar
# token butuh client_secret, WAJIB di server.
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
ACCURATE_REDIRECT_URI=http://localhost:3001/accurate/oauth/callback
ACCURATE_TOKEN_ENCRYPTION_KEY=ganti-dengan-random-string-panjang-buat-dev
