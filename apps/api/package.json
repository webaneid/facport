{
  "name": "@facport/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:worker": "bun run --watch src/workers/index.ts",
    "start": "bun run src/index.ts",
    "start:worker": "bun run src/workers/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external sharp",
    "build:worker": "bun build ./src/workers/index.ts --outfile ./dist/worker.js --target bun --external sharp",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@elysia/cors": "^1.4.2",
    "@sentry/bun": "^9.15.0",
    "@sinclair/typebox": "^0.34.0",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "elysia": "^1.4.29",
    "minio": "^8.0.5",
    "pg-boss": "^12.27.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "resend": "^6.20.0",
    "sharp": "^0.34.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3"
  }
}
