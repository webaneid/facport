# apps/web/.env.example
# Copy jadi .env.local untuk development lokal. JANGAN commit .env.local asli.

NEXT_PUBLIC_API_URL=http://localhost:3001
# Origin surface "app" — dipakai landing page buat link daftar/login lintas
# subdomain (§ architecture-domain-routing.md — link CROSS-SURFACE WAJIB
# absolute URL, bukan path relatif, kalau tidak resolve ke surface salah)
NEXT_PUBLIC_APP_URL=http://app.localhost:6209
# Origin surface "landing" (root domain, TANPA subdomain) — dipakai admin
# invoices page buat link pembayaran PUBLIK (§ Fase 27, ADR-0025 —
# `/pay/[orderId]` sengaja di surface landing, satu-satunya tanpa auth
# guard di proxy.ts). Sama prinsip cross-surface link WAJIB absolute URL.
NEXT_PUBLIC_LANDING_URL=http://localhost:6209

# Observability (kosongkan = disabled) — lihat
# docs/architecture/architecture-observability.md
NEXT_PUBLIC_SENTRY_DSN=
