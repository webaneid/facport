# .env.staging.example
# Copy jadi .env.staging DI SERVER (bukan di git), isi nilai asli.
# TERPISAH dari .env.production — JANGAN pernah pakai kredensial/DB yang
# sama dengan production (lihat docs/decisions/adr-0003-staging-environment.md:
# staging tidak boleh pakai data production asli).

GITHUB_REPO=webaneid/facport

DB_USER=
DB_PASSWORD=
DB_NAME=app_staging
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

NEXT_PUBLIC_API_URL=https://api-staging.namadomain.com
NEXT_PUBLIC_APP_URL=https://app-staging.namadomain.com
# Staging cuma expose admin-staging & app-staging (lihat Caddyfile — tidak
# ada domain landing terpisah untuk staging)
WEB_ORIGINS_PROD=https://admin-staging.namadomain.com,https://app-staging.namadomain.com
APP_ORIGIN_PROD=https://app-staging.namadomain.com
COOKIE_DOMAIN=.namadomain.com

# Observability — disarankan pakai project Sentry TERPISAH dari production
# (atau minimal environment tag beda), supaya error staging tidak nyampur
# sama alert production.
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug
