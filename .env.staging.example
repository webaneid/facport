# .env.staging.example
# Copy jadi .env.staging DI SERVER (bukan di git), isi nilai asli.
# TERPISAH dari .env.production — JANGAN pernah pakai kredensial/DB yang
# sama dengan production (lihat docs/decisions/adr-0003-staging-environment.md:
# staging tidak boleh pakai data production asli).

GITHUB_REPO=webaneid/facport

DB_USER=
DB_PASSWORD=
DB_NAME=app_staging
# WAJIB tulis literal — `env_file:` TIDAK substitusi ${...} di dalam .env
# (lihat catatan sama di .env.production.example). Contoh:
# DATABASE_URL=postgres://facport:isi-password-asli-di-atas@postgres:5432/app_staging
DATABASE_URL=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Base URL browser-facing untuk bucket public (logo/favicon) — § Fase 12,
# ADR-0017. Host baru, WAJIB di-setup DNS-nya + ditambah ke Caddyfile
# (lihat docs/architecture/architecture-deployment.md).
MINIO_PUBLIC_URL=https://media-staging.namadomain.com

NEXT_PUBLIC_API_URL=https://api-staging.namadomain.com
NEXT_PUBLIC_APP_URL=https://app-staging.namadomain.com
# Staging cuma expose admin-staging & app-staging (lihat Caddyfile — tidak
# ada domain landing terpisah untuk staging)
WEB_ORIGINS_PROD=https://admin-staging.namadomain.com,https://app-staging.namadomain.com
APP_ORIGIN_PROD=https://app-staging.namadomain.com
COOKIE_DOMAIN=.namadomain.com

# Observability — disarankan pakai project Sentry TERPISAH dari production
# (atau minimal environment tag beda), supaya error staging tidak nyampur
# sama alert production.
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# Fase 167 — jumlah koneksi Accurate yang diproses paralel oleh worker import (default 2, 1-8). Worker harus tetap 1 container.
# IMPORT_WORKER_CONCURRENCY=2

# Fase 199 — timeout panggilan ke Accurate (sebelumnya default runtime Bun, bergeser antar versi). save.do: adaptif = baris detail × ms/baris, dijepit min–max.
# Biaya Accurate terukur ±0,25–0,28 dtk/baris (linear); 600 ms/baris = faktor ±2×. Semua opsional.
# ACCURATE_SAVE_TIMEOUT_MIN_MS=360000
# ACCURATE_SAVE_TIMEOUT_MAX_MS=3600000
# ACCURATE_SAVE_MS_PER_LINE=600
# ACCURATE_REQUEST_TIMEOUT_MS=360000

# Fase 199 — jalur terpisah batch besar: batch ≥ IMPORT_LARGE_BATCH_ROWS baris diproses di slot sendiri (IMPORT_LARGE_WORKER_CONCURRENCY) agar tidak
# menghabiskan slot batch kecil pelanggan lain. Semua opsional.
# IMPORT_LARGE_BATCH_ROWS=1500
# IMPORT_LARGE_WORKER_CONCURRENCY=2
